# Meme-it API (backend/). Copy to backend/.env for local runs; on Cloud Run the
# whole file is uploaded as the repo's DOTENV secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-janani-meme-it < backend/.env
# Never commit the real .env.
# Cloud Run URL: https://ail-ay2627-s1-janani-meme-it-464725632804.asia-southeast3.run.app

# OpenRouter: the one vision call that counts people and writes the captions.
OPENROUTER_API_KEY=your-openrouter-key
# Any OpenRouter vision model that can return JSON. The prompt was tuned on this one;
# google/gemini-2.5-flash-lite is a cheaper fallback.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Comma-separated frontend origins allowed to call the API.
# Production: https://ail-ay2627-s1-janani-meme-it.vercel.app
CORS_ORIGINS=http://localhost:5173

# Shared rate-limit store (Upstash Redis). Leave empty locally to disable rate limiting.
# The short names UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback limit for the 'captions' bucket (requests per IP per window); the central
# sheet overrides it. Each photo uses one call to check who is in it plus one per
# "Find my memes".
RATE_LIMIT_CAPTIONS_MAX=5
# Rolling window in seconds (432000 = 5 days).
RATE_LIMIT_WINDOW_SECONDS=432000
